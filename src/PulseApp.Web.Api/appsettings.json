{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pulseapp;Username=postgres;Password=postgres",
    "PulseDataContext": "Host=localhost;Port=5432;Database=pulseapp;Username=postgres;Password=postgres",
    "DataContext": "",
    "Logs": ""
  },
  "VapidSettings": {
    "Subject": "mailto:admin@pulseapp.com"
  },
