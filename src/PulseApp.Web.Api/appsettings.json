  "Serilog": {
    "MinimumLevel" : {
      "Default" : "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.LifeTime": "Information",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
